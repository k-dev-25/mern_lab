{
  "info": { "name": "ShopKart Lab 02 - Auth API Judging", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Judging collection derived from Lab-02. Run in order; Postman cookie jar carries the HttpOnly token." },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    { "name": "Register - valid", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"{{testPhone}}\"\n}" }, "url": "{{baseUrl}}/customers/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.test('success response', () => pm.expect(pm.response.json().success).to.eql(true));", "pm.test('password is not exposed', () => pm.expect(pm.response.text()).to.not.include('password'));"], "type": "text/javascript" } }] },
    { "name": "Register - missing field (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fullName\":\"Incomplete\",\"email\":\"missing-field@example.com\",\"password\":\"secret123\"}" }, "url": "{{baseUrl}}/customers/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
    { "name": "Register - short password (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fullName\":\"Short Password\",\"email\":\"short-password@example.com\",\"password\":\"123\",\"phone\":\"9876543210\"}" }, "url": "{{baseUrl}}/customers/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
    { "name": "Login - valid and cookie", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\"}" }, "url": "{{baseUrl}}/customers/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('token cookie set', () => pm.expect(pm.cookies.has('token')).to.eql(true));", "pm.test('customer returned without password', () => pm.expect(pm.response.json().customer.password).to.be.undefined);"], "type": "text/javascript" } }] },
    { "name": "Login - invalid credentials (401)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"wrong-password\"}" }, "url": "{{baseUrl}}/customers/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));", "pm.test('invalid credentials message', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('invalid'));"], "type": "text/javascript" } }] },
    { "name": "Me - authenticated", "request": { "method": "GET", "url": "{{baseUrl}}/customers/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('customer fields returned', () => pm.expect(pm.response.json()).to.have.all.keys('_id','fullName','email','phone','createdAt','__v'));"], "type": "text/javascript" } }] },
    { "name": "Logout - clears session", "request": { "method": "POST", "url": "{{baseUrl}}/customers/logout" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('success response', () => pm.expect(pm.response.json().success).to.eql(true));"], "type": "text/javascript" } }] },
    { "name": "Me - unauthenticated (401)", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "", "disabled": true }], "url": "{{baseUrl}}/customers/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }] }
  ]
}
