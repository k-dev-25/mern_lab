{
  "info": {"name":"ShopKart Lab 05 - Cart","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Run in order. Login stores the cookie; setup creates one product for cart tests."},
  "variable": [
    {"key":"baseUrl","value":"http://localhost:3000"},
    {"key":"testEmail","value":"cart-judge@example.com"},
    {"key":"testPassword","value":"shopkart123"}
  ],
  "item": [
    {"name":"Setup - register judge user","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"fullName\":\"Cart Judge\",\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\",\"phone\":\"9876543210\"}"},"url":"{{baseUrl}}/customers/register"},"event":[{"listen":"test","script":{"exec":["pm.test('registered or already exists', () => pm.expect([201,409]).to.include(pm.response.code));"],"type":"text/javascript"}}]},
    {"name":"Setup - login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\"}"},"url":"{{baseUrl}}/customers/login"},"event":[{"listen":"test","script":{"exec":["pm.test('login succeeded', () => pm.response.to.have.status(200));","pm.test('token cookie set', () => pm.expect(pm.cookies.has('token')).to.eql(true));"],"type":"text/javascript"}}]},
    {"name":"Setup - create product","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Cart Test Product {{$timestamp}}\",\"description\":\"Product for cart API checks.\",\"price\":2999,\"category\":\"Electronics\",\"image\":\"https://example.com/product.jpg\",\"stock\":10}"},"url":"{{baseUrl}}/products"},"event":[{"listen":"test","script":{"exec":["pm.test('product created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('productId', pm.response.json().product._id);"],"type":"text/javascript"}}]},
    {"name":"Test 1 - add item","request":{"method":"POST","url":"{{baseUrl}}/cart/{{productId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('item added with quantity 1', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().cart[0].quantity).to.eql(1); });"],"type":"text/javascript"}}]},
    {"name":"Test 2 - add same item increments","request":{"method":"POST","url":"{{baseUrl}}/cart/{{productId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('quantity incremented to 2', () => pm.expect(pm.response.json().cart[0].quantity).to.eql(2));"],"type":"text/javascript"}}]},
    {"name":"Test 3 - get populated cart","request":{"method":"GET","url":"{{baseUrl}}/cart"},"event":[{"listen":"test","script":{"exec":["const item = pm.response.json().cart[0];","pm.test('product populated and quantity retained', () => { pm.response.to.have.status(200); pm.expect(item.product.name).to.include('Cart Test Product'); pm.expect(item.quantity).to.eql(2); });"],"type":"text/javascript"}}]},
    {"name":"Test 4 - update quantity","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"quantity\":3}"},"url":"{{baseUrl}}/cart/{{productId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('quantity updated', () => pm.expect(pm.response.json().cart[0].quantity).to.eql(3));"],"type":"text/javascript"}}]},
    {"name":"Test 5 - exceed stock","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"quantity\":11}"},"url":"{{baseUrl}}/cart/{{productId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('stock limit rejected', () => pm.response.to.have.status(400));"],"type":"text/javascript"}}]},
    {"name":"Test 6 - remove item","request":{"method":"DELETE","url":"{{baseUrl}}/cart/{{productId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('cart emptied', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().cart).to.have.length(0); });"],"type":"text/javascript"}}]},
    {"name":"Test 7 - unauthenticated","request":{"method":"GET","header":[{"key":"Cookie","value":"token=invalid"}],"url":"{{baseUrl}}/cart"},"event":[{"listen":"test","script":{"exec":["pm.test('unauthorized', () => pm.response.to.have.status(401));"],"type":"text/javascript"}}]}
  ]
}
