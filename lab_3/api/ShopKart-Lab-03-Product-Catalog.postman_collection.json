{
  "info": { "name": "ShopKart Lab 03 - Product API Judging", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Judging collection derived from Lab-03. Register and login first; the Postman cookie jar authenticates product reads." },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    { "name": "Setup - register judge user", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fullName\":\"Catalog Judge\",\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\",\"phone\":\"9876543210\"}" }, "url": "{{baseUrl}}/customers/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('registered or already exists', () => pm.expect([201,409]).to.include(pm.response.code));"], "type": "text/javascript" } }] },
    { "name": "Setup - login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\"}" }, "url": "{{baseUrl}}/customers/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('token cookie set', () => pm.expect(pm.cookies.has('token')).to.eql(true));"], "type": "text/javascript" } }] },
    { "name": "Create product - valid (201)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Postman Keyboard {{$timestamp}}\",\"description\":\"RGB mechanical keyboard with blue switches.\",\"price\":2999,\"category\":\"Electronics\",\"image\":\"https://example.com/keyboard.jpg\",\"stock\":10}" }, "url": "{{baseUrl}}/products" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.test('product returned', () => pm.expect(pm.response.json().product).to.have.property('_id'));", "pm.environment.set('productId', pm.response.json().product._id);"], "type": "text/javascript" } }] },
    { "name": "Create product - invalid price (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Bad Price\",\"description\":\"Invalid\",\"price\":0,\"category\":\"Books\",\"image\":\"https://example.com/bad.jpg\",\"stock\":1}" }, "url": "{{baseUrl}}/products" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
    { "name": "Create product - negative stock (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Bad Stock\",\"description\":\"Invalid\",\"price\":10,\"category\":\"Books\",\"image\":\"https://example.com/bad.jpg\",\"stock\":-1}" }, "url": "{{baseUrl}}/products" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
    { "name": "Get all products", "request": { "method": "GET", "url": "{{baseUrl}}/products" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('success/count/products contract', () => { pm.expect(body.success).to.eql(true); pm.expect(body.count).to.eql(body.products.length); });", "pm.test('list fields only', () => pm.expect(body.products[0] || {}).to.not.have.any.keys('description','createdAt'));"], "type": "text/javascript" } }] },
    { "name": "Search products - case insensitive", "request": { "method": "GET", "url": "{{baseUrl}}/products?search=KEYBOARD" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('search returns matching names', () => pm.response.json().products.forEach(p => pm.expect(p.name.toLowerCase()).to.include('keyboard')));"], "type": "text/javascript" } }] },
    { "name": "Filter by category", "request": { "method": "GET", "url": "{{baseUrl}}/products?category=Electronics" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('all products are Electronics', () => pm.response.json().products.forEach(p => pm.expect(p.category).to.eql('Electronics')));"], "type": "text/javascript" } }] },
    { "name": "Combined search and category", "request": { "method": "GET", "url": "{{baseUrl}}/products?search=keyboard&category=Electronics" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('both filters applied', () => pm.response.json().products.forEach(p => { pm.expect(p.name.toLowerCase()).to.include('keyboard'); pm.expect(p.category).to.eql('Electronics'); }));"], "type": "text/javascript" } }] },
    { "name": "Get single product", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('detail includes required fields', () => pm.expect(body.product).to.have.all.keys('_id','name','description','price','category','image','stock','createdAt'));"], "type": "text/javascript" } }] },
    { "name": "Get single product - invalid id (400)", "request": { "method": "GET", "url": "{{baseUrl}}/products/not-an-object-id" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
    { "name": "Get single product - not found (404)", "request": { "method": "GET", "url": "{{baseUrl}}/products/507f1f77bcf86cd799439011" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }] }
  ]
}
